#!/usr/bin/env node
/* eslint-disable no-console */
const { spawn } = require('node:child_process')
const fs = require('node:fs')
const http = require('node:http')
const net = require('node:net')
const os = require('node:os')
const path = require('node:path')

const BASE = process.env.PROXIMA_SMOKE_BASE || 'http://127.0.0.1:8767'
const SKIP_BROWSER = process.env.PROXIMA_SMOKE_SKIP_BROWSER === '1'

function request(path, { method = 'GET', body, headers = {} } = {}) {
  const url = new URL(path, BASE)
  const data = body === undefined ? undefined : Buffer.from(JSON.stringify(body))
  return new Promise((resolve, reject) => {
    const req = http.request(url, {
      method,
      headers: {
        'Content-Type': 'application/json',
        ...(data ? { 'Content-Length': data.length } : {}),
        ...headers,
      },
      timeout: 15000,
    }, res => {
      let raw = ''
      res.setEncoding('utf8')
      res.on('data', chunk => { raw += chunk })
      res.on('end', () => {
        let parsed = {}
        if (raw.trim()) {
          try { parsed = JSON.parse(raw) } catch (err) { return reject(new Error(`${method} ${path} returned invalid JSON: ${err.message}`)) }
        }
        if (res.statusCode < 200 || res.statusCode >= 300) {
          return reject(new Error(`${method} ${path} failed with ${res.statusCode}: ${raw.slice(0, 500)}`))
        }
        resolve({ status: res.statusCode, body: parsed })
      })
    })
    req.on('timeout', () => req.destroy(new Error(`${method} ${path} timed out`)))
    req.on('error', reject)
    if (data) req.write(data)
    req.end()
  })
}

function getJson(port, path) {
  return new Promise((resolve, reject) => {
    http.get({ host: '127.0.0.1', port, path }, res => {
      let raw = ''
      res.setEncoding('utf8')
      res.on('data', chunk => { raw += chunk })
      res.on('end', () => {
        try { resolve(JSON.parse(raw)) } catch (err) { reject(err) }
      })
    }).on('error', reject)
  })
}

const sleep = ms => new Promise(resolve => setTimeout(resolve, ms))

async function stopBrowser(chrome, userDataDir) {
  const exited = new Promise(resolve => chrome.once('exit', resolve))
  if (chrome.exitCode === null && chrome.signalCode === null) {
    chrome.kill('SIGTERM')
    await Promise.race([exited, sleep(3000)])
  }
  if (chrome.exitCode === null && chrome.signalCode === null) {
    chrome.kill('SIGKILL')
    await Promise.race([exited, sleep(1000)])
  }
  for (let attempt = 0; attempt < 5; attempt += 1) {
    try {
      fs.rmSync(userDataDir, { recursive: true, force: true })
      return
    } catch (err) {
      if (err.code !== 'ENOTEMPTY' || attempt === 4) throw err
      await sleep(100)
    }
  }
}

function freePort() {
  return new Promise((resolve, reject) => {
    const server = net.createServer()
    server.unref()
    server.on('error', reject)
    server.listen(0, '127.0.0.1', () => {
      const address = server.address()
      const port = typeof address === 'object' && address ? address.port : null
      server.close(() => port ? resolve(port) : reject(new Error('could not allocate a free port')))
    })
  })
}

async function apiSmoke() {
  let health
  for (let i = 0; i < 40; i += 1) {
    try {
      health = await request('/api/health')
      break
    } catch (err) {
      if (i === 39) throw err
      await sleep(250)
    }
  }
  if (!health.body.ok || health.body.database !== 'ok' || health.body.product !== 'proxima') {
    throw new Error(`unhealthy or wrong-product API: ${JSON.stringify(health.body)}`)
  }
  console.log('api: health ok (proxima)')

  const suppliedToken = process.env.PROXIMA_SMOKE_TOKEN || ''
  const password = process.env.PROXIMA_SMOKE_PASSWORD || ''
  const auth = suppliedToken
    ? { body: { token: suppliedToken, user: { username: 'token-authenticated owner' } } }
    : await request(password ? '/auth/login' : '/auth/auto', { method: 'POST', body: password ? { password } : {} })
  const token = auth.body.token
  if (!token || !auth.body.user?.username) throw new Error(`auth/auto returned unexpected payload: ${JSON.stringify(auth.body)}`)
  const headers = { Authorization: `Bearer ${token}` }
  console.log(`api: auth ok (${auth.body.user.username})`)

  const debug = await request('/api/debug/logs', { headers })
  if (!Array.isArray(debug.body.activeRuns) || !Array.isArray(debug.body.staleRuns)) throw new Error('debug logs missing activeRuns/staleRuns arrays')
  console.log(`api: debug logs ok (${debug.body.activeRuns.length} active, ${debug.body.staleRuns.length} stale)`)

  const dashboard = await request('/api/dashboard', { headers })
  if (typeof dashboard.body.counts?.activeRuns !== 'number') throw new Error('dashboard counts.activeRuns is not numeric')
  console.log('api: dashboard ok')

  const projects = await request('/api/projects', { headers })
  let project = projects.body.projects?.[0]
  let ownsProject = false
  if (!project?.slug) {
    const slug = `proxima-smoke-${Date.now()}`
    const createdProject = await request('/api/projects', {
      method: 'POST',
      headers,
      body: { slug, name: 'Proxima Smoke' },
    })
    project = createdProject.body
    if (!project?.slug) throw new Error(`temporary project create failed: ${JSON.stringify(createdProject.body)}`)
    ownsProject = true
    console.log(`api: temporary project created (${project.slug})`)
  }

  try {
    const smokeDir = `.proxima-smoke-${Date.now()}`
    const smokeFile = `${smokeDir}/note.md`
    const smokeRenamed = `${smokeDir}/renamed.md`
    const smokeWikiFile = `wiki/${smokeDir}/index.md`
    try {
      await request(`/api/projects/${encodeURIComponent(project.slug)}/file?path=${encodeURIComponent(smokeFile)}`, {
        method: 'PUT',
        headers,
        body: { content: '# Smoke\n\nok' },
      })
      const readBack = await request(`/api/projects/${encodeURIComponent(project.slug)}/file?path=${encodeURIComponent(smokeFile)}`, { headers })
      if (readBack.body.content !== '# Smoke\n\nok') throw new Error('file smoke read-back mismatch')
      await request(`/api/projects/${encodeURIComponent(project.slug)}/fs/rename`, {
        method: 'POST',
        headers,
        body: { from: smokeFile, to: smokeRenamed },
      })
      const tree = await request(`/api/projects/${encodeURIComponent(project.slug)}/tree?path=${encodeURIComponent(smokeDir)}`, { headers })
      if (!tree.body.entries?.some(e => e.name === 'renamed.md')) throw new Error('file smoke renamed entry missing from tree')
      await request(`/api/projects/${encodeURIComponent(project.slug)}/file?path=${encodeURIComponent(smokeWikiFile)}`, {
        method: 'PUT',
        headers,
        body: { content: '# Smoke Wiki\n\n[[renamed]]' },
      })
      const wiki = await request(`/api/projects/${encodeURIComponent(project.slug)}/wiki/all`, { headers })
      if (!wiki.body.notes?.some(n => n.path === `${smokeDir}/index.md` && n.content.includes('Smoke Wiki'))) throw new Error('wiki smoke note missing from bulk load')
      console.log('api: file write/read/rename/tree + wiki bulk ok')
    } finally {
      await request(`/api/projects/${encodeURIComponent(project.slug)}/fs?path=${encodeURIComponent(smokeDir)}`, { method: 'DELETE', headers, body: {} }).catch(() => {})
      await request(`/api/projects/${encodeURIComponent(project.slug)}/fs?path=${encodeURIComponent(`wiki/${smokeDir}`)}`, { method: 'DELETE', headers, body: {} }).catch(() => {})
    }

    const workflowName = `Smoke Workflow ${Date.now()}`
    const created = await request('/api/workflows', {
      method: 'POST',
      headers,
      body: { name: workflowName, project_slug: project.slug, steps: [{ name: 'Check', prompt: 'Return ok' }] },
    })
    if (!created.body.id) throw new Error(`workflow create missing id: ${JSON.stringify(created.body)}`)
    const workflowId = created.body.id

    try {
      const list = await request(`/api/workflows?project_slug=${encodeURIComponent(project.slug)}`, { headers })
      if (!list.body.some(row => row.id === workflowId)) throw new Error('created workflow was not returned by list endpoint')
      console.log(`api: workflow create/list ok (${workflowId})`)
    } finally {
      const deleted = await request(`/api/workflows/${workflowId}`, { method: 'DELETE', headers, body: {} })
      if (!deleted.body.ok) throw new Error(`workflow delete failed: ${JSON.stringify(deleted.body)}`)
      console.log(`api: workflow delete ok (${workflowId})`)
    }
  } finally {
    if (ownsProject) {
      await request(`/api/projects/${encodeURIComponent(project.slug)}`, { method: 'DELETE', headers, body: {} })
      console.log(`api: temporary project deleted (${project.slug})`)
    }
  }
  return token
}

async function createWorkflowIntakeFixture(token) {
  const headers = { Authorization: `Bearer ${token}` }
  const projects = await request('/api/projects', { headers })
  let project = projects.body.projects?.[0]
  let ownsProject = false
  if (!project?.slug) {
    const slug = `workflow-intake-smoke-${Date.now()}`
    project = (await request('/api/projects', {
      method: 'POST',
      headers,
      body: { slug, name: 'Workflow Intake Smoke' },
    })).body
    ownsProject = true
  }
  if (!project?.slug) throw new Error('workflow intake browser smoke needs a project')
  const title = `Workflow intake integrity ${Date.now()}`
  const job = await request('/api/graph/jobs', {
    method: 'POST',
    headers,
    body: {
      title,
      project_slug: project.slug,
      graph: {
        nodes: [{
          id: 'trigger',
          type: 'trigger',
          trigger_kind: 'manual',
          name: 'When I run it',
          inputs: [],
        }],
        edges: [],
      },
    },
  })
  return { id: job.body.id, title, projectSlug: project.slug, ownsProject }
}

async function deleteWorkflowIntakeFixture(token, fixture) {
  if (!fixture) return
  const headers = { Authorization: `Bearer ${token}` }
  await request(`/api/jobs/${fixture.id}`, { method: 'DELETE', headers, body: {} }).catch(() => {})
  if (fixture.ownsProject) {
    await request(`/api/projects/${encodeURIComponent(fixture.projectSlug)}`, {
      method: 'DELETE',
      headers,
      body: {},
    }).catch(() => {})
  }
}

async function waitForTarget(port) {
  for (let i = 0; i < 80; i += 1) {
    try {
      const pages = await getJson(port, '/json')
      const page = pages.find(p => p.type === 'page' && p.url?.startsWith(BASE))
      if (page?.webSocketDebuggerUrl) return page.webSocketDebuggerUrl
    } catch {}
    await sleep(250)
  }
  throw new Error(`Chrome DevTools target for ${BASE} was not ready`)
}

async function workflowIntakeBrowserRegression(send, fixture) {
  const phaseOne = await send('Runtime.evaluate', {
    awaitPromise: true,
    returnByValue: true,
    expression: `(${async function (title, jobId) {
      const wait = ms => new Promise(resolve => setTimeout(resolve, ms))
      const body = () => document.body.innerText || ''
      async function until(check, message, attempts = 60) {
        for (let i = 0; i < attempts; i += 1) {
          const result = await check()
          if (result) return result
          await wait(150)
        }
        throw new Error(`${message}\n${body().slice(0, 800)}`)
      }
      function clickText(label, scope = document) {
        const node = [...scope.querySelectorAll('button, [role="button"], a')]
          .find(item => (item.textContent || '').trim() === label)
        if (!node) throw new Error(`missing ${label}`)
        node.click()
      }
      function setInput(label, value, blur = true) {
        const input = document.querySelector(`[aria-label="${label}"]`)
        if (!(input instanceof HTMLInputElement)) throw new Error(`missing input ${label}`)
        input.focus()
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set
        setter.call(input, value)
        input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: value }))
        if (blur) input.blur()
        return input
      }
      async function job() {
        const response = await fetch(`/api/graph/jobs/${jobId}`)
        if (!response.ok) throw new Error(`job read failed: ${response.status}`)
        return response.json()
      }

      const workflows = await until(
        () => [...document.querySelectorAll('.sidebar button, .sidebar a')]
          .find(node => (node.textContent || '').trim() === 'Workflows'),
        'Workflows navigation did not load',
      )
      workflows.click()
      await until(() => body().includes('Workflows'), 'Workflows did not open')
      const draftsTab = await until(
        () => [...document.querySelectorAll('[role="tab"]')]
          .find(node => (node.textContent || '').trim().startsWith('Drafts ')),
        'Drafts tab missing',
      )
      draftsTab.click()
      const row = await until(
        () => [...document.querySelectorAll('[role="row"]')]
          .find(node => (node.textContent || '').includes(title)),
        `draft ${title} missing`,
      )
      clickText('Edit', row)
      await until(() => body().includes(title) && document.querySelector('.graph-canvas'), 'draft editor did not open')
      const trigger = await until(
        () => document.querySelector('[role="button"][aria-label^="When I run it,"]'),
        'manual trigger node missing',
      )
      trigger.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }))
      await until(() => body().toLowerCase().includes('intake form'), 'trigger inspector did not open')

      clickText('+ Add field')
      await until(async () => {
        const inputs = (await job()).graph.nodes[0].inputs
        return inputs.length === 1 && inputs[0].id === 'field' && inputs[0].label === 'New field'
      }, 'complete generated intake row was not saved')

      const nativeFetch = window.fetch.bind(window)
      let rejectNextGraphPatch = true
      window.fetch = (resource, init = {}) => {
        const url = typeof resource === 'string' ? resource : resource.url
        if (rejectNextGraphPatch
          && init.method === 'PATCH'
          && url.includes(`/api/graph/jobs/${jobId}/graph`)) {
          rejectNextGraphPatch = false
          return Promise.reject(new TypeError('simulated graph persistence rejection'))
        }
        return nativeFetch(resource, init)
      }
      setInput('Input 1 label', 'Network rejected')
      await until(
        () => body().includes('Not saved')
          && [...document.querySelectorAll('button')].some(node => (node.textContent || '').trim() === 'Retry save'),
        'network rejection did not keep the graph unsaved with Retry',
      )
      if ((await job()).graph.nodes[0].inputs[0].label !== 'New field') {
        throw new Error('rejected graph edit reached persistence')
      }
      window.fetch = nativeFetch
      clickText('Retry save')
      await until(async () => {
        const state = await job()
        return state.graph.nodes[0].inputs[0].label === 'Network rejected'
          && body().includes('Saved ✓')
      }, 'Retry did not persist the rejected edit')

      setInput('Input 1 ID', 'bad id')
      await until(() => {
        const id = document.querySelector('[aria-label="Input 1 ID"]')
        return id?.getAttribute('aria-invalid') === 'true' && body().includes('Not saved')
      }, 'invalid ID did not block save')
      const invalidRun = [...document.querySelectorAll('.graph-editor-footer button')]
        .find(node => (node.textContent || '').trim().endsWith('Run'))
      if (!invalidRun?.disabled) throw new Error('Run stayed enabled for invalid intake')
      const rejectedState = await job()
      if (rejectedState.graph.nodes[0].inputs[0].id !== 'field') {
        throw new Error('invalid staged ID reached persistence')
      }

      setInput('Input 1 label', 'Campaign')
      setInput('Input 1 ID', 'campaign')
      const required = document.querySelector('[aria-label="Input 1 required"]')
      if (!(required instanceof HTMLInputElement)) throw new Error('required checkbox missing')
      required.click()
      await wait(50)

      clickText('+ Add field')
      await until(() => document.querySelector('[aria-label="Input 2 label"]'), 'second intake row did not render')
      setInput('Input 2 label', 'Channel')
      setInput('Input 2 default', 'email')
      setInput('Input 2 ID', 'channel')
      await wait(50)

      clickText('+ Add field')
      const remove = await until(() => {
        const buttons = [...document.querySelectorAll('button[aria-label="Remove input"]')]
        return buttons.length === 3 ? buttons : null
      }, 'third intake row missing before delete')
      remove[2].click()

      await until(async () => {
        const state = await job()
        const inputs = state.graph.nodes[0].inputs
        return inputs.length === 2
          && inputs[0].id === 'campaign'
          && inputs[0].label === 'Campaign'
          && inputs[0].required === true
          && inputs[1].id === 'channel'
          && inputs[1].label === 'Channel'
          && inputs[1].default === 'email'
      }, 'rapid intake edits and delete did not persist')
      await until(() => body().includes('Saved ✓'), 'accepted intake did not become Saved')
      return 'workflow-intake-edit:ok'
    }})(${JSON.stringify(fixture.title)}, ${fixture.id})`,
  })
  if (phaseOne.result.value !== 'workflow-intake-edit:ok') {
    throw new Error(`unexpected workflow intake edit result: ${JSON.stringify(phaseOne)}`)
  }

  await send('Page.reload', { ignoreCache: true })
  await sleep(2500)
  const phaseTwo = await send('Runtime.evaluate', {
    awaitPromise: true,
    returnByValue: true,
    expression: `(${async function (title, jobId) {
      const wait = ms => new Promise(resolve => setTimeout(resolve, ms))
      const body = () => document.body.innerText || ''
      async function until(check, message, attempts = 60) {
        for (let i = 0; i < attempts; i += 1) {
          const result = await check()
          if (result) return result
          await wait(150)
        }
        throw new Error(`${message}\n${body().slice(0, 800)}`)
      }
      function clickText(label, scope = document) {
        const node = [...scope.querySelectorAll('button, [role="button"], a')]
          .find(item => (item.textContent || '').trim() === label)
        if (!node) throw new Error(`missing ${label}`)
        node.click()
      }
      function setInput(label, value) {
        const input = document.querySelector(`[aria-label="${label}"]`)
        if (!(input instanceof HTMLInputElement)) throw new Error(`missing input ${label}`)
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set
        setter.call(input, value)
        input.dispatchEvent(new InputEvent('input', { bubbles: true, inputType: 'insertText', data: value }))
      }
      async function job() {
        const response = await fetch(`/api/graph/jobs/${jobId}`)
        if (!response.ok) throw new Error(`job read failed: ${response.status}`)
        return response.json()
      }

      const workflows = await until(
        () => [...document.querySelectorAll('.sidebar button, .sidebar a')]
          .find(node => (node.textContent || '').trim() === 'Workflows'),
        'Workflows navigation did not reload',
      )
      workflows.click()
      await until(() => body().includes('Workflows'), 'Workflows did not reopen')
      const draftsTab = await until(
        () => [...document.querySelectorAll('[role="tab"]')]
          .find(node => (node.textContent || '').trim().startsWith('Drafts ')),
        'Drafts tab missing after reload',
      )
      draftsTab.click()
      const row = await until(
        () => [...document.querySelectorAll('[role="row"]')]
          .find(node => (node.textContent || '').includes(title)),
        `reloaded draft ${title} missing`,
      )
      clickText('Edit', row)
      await until(() => body().includes(title) && document.querySelector('.graph-canvas'), 'reloaded editor did not open')
      const trigger = await until(
        () => document.querySelector('[role="button"][aria-label^="When I run it,"]'),
        'reloaded trigger missing',
      )
      trigger.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }))
      await until(() => document.querySelector('[aria-label="Input 2 default"]'), 'reloaded intake fields missing')

      const values = ['Campaign', 'campaign', 'Channel', 'channel', 'email']
      const labels = ['Input 1 label', 'Input 1 ID', 'Input 2 label', 'Input 2 ID', 'Input 2 default']
      labels.forEach((label, index) => {
        const input = document.querySelector(`[aria-label="${label}"]`)
        if (!(input instanceof HTMLInputElement) || input.value !== values[index]) {
          throw new Error(`${label} did not survive reload`)
        }
      })
      const required = document.querySelector('[aria-label="Input 1 required"]')
      if (!(required instanceof HTMLInputElement) || !required.checked) {
        throw new Error('required flag did not survive reload')
      }
      const run = [...document.querySelectorAll('.graph-editor-footer button')]
        .find(node => (node.textContent || '').trim().endsWith('Run'))
      if (!run || run.disabled) throw new Error('saved valid draft could not run')
      run.click()

      await until(() => document.querySelector(`[role="dialog"][aria-label="Run ${title}"]`), 'validated Run dialog missing')
      clickText('Run workflow', document.querySelector('[role="dialog"]'))
      await until(() => body().includes('Campaign') && body().includes('required'), 'required value error missing')
      if ((await job()).status !== 'queued') throw new Error('invalid dialog submission started the job')

      setInput('Campaign', 'Launch week')
      clickText('Run workflow', document.querySelector('[role="dialog"]'))
      const executed = await until(async () => {
        const state = await job()
        return state.status === 'review' ? state : null
      }, 'valid intake did not execute')
      const expected = { campaign: 'Launch week', channel: 'email' }
      if (JSON.stringify(executed.input) !== JSON.stringify(expected)) {
        throw new Error(`unexpected resolved input: ${JSON.stringify(executed.input)}`)
      }
      const triggerState = executed.node_states.find(state => state.node_id === 'trigger')
      if (JSON.stringify(triggerState?.output) !== JSON.stringify(expected)
        || JSON.stringify(triggerState?.inputs?.job_input) !== JSON.stringify(expected)) {
        throw new Error('trigger did not execute with the resolved input')
      }
      const reviewedTrigger = await until(
        () => document.querySelector('[role="button"][aria-label^="When I run it,"]'),
        'review trigger missing',
      )
      reviewedTrigger.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter', bubbles: true }))
      await until(() => body().includes('Resolved inputs') && body().includes('Launch week'), 'resolved inputs not visible')
      return 'workflow-intake-run:ok'
    }})(${JSON.stringify(fixture.title)}, ${fixture.id})`,
  })
  if (phaseTwo.result.value !== 'workflow-intake-run:ok') {
    throw new Error(`unexpected workflow intake run result: ${JSON.stringify(phaseTwo)}`)
  }
  console.log('browser:desktop: workflow intake create/edit/delete/reload/run ok')
}

async function browserNavigationSmoke({ name, width, height, port, mobile, token, workflowFixture }) {
  const userDataDir = fs.mkdtempSync(path.join(os.tmpdir(), `proxima-smoke-${name}-`))
  const chrome = spawn('google-chrome', [
    '--headless=new',
    '--disable-gpu',
    '--no-sandbox',
    '--disable-dev-shm-usage',
    `--user-data-dir=${userDataDir}`,
    `--remote-debugging-port=${port}`,
    `--window-size=${width},${height}`,
    BASE,
  ], { stdio: ['ignore', 'ignore', 'pipe'] })
  let stderr = ''
  chrome.stderr.on('data', chunk => { stderr += chunk.toString() })

  try {
    const wsUrl = await waitForTarget(port)
    const ws = new WebSocket(wsUrl)
    let id = 0
    const pending = new Map()
    const clientErrors = []
    ws.onmessage = event => {
      const message = JSON.parse(event.data)
      if (message.method === 'Runtime.exceptionThrown') clientErrors.push(message.params.exceptionDetails?.text || message.params.exceptionDetails?.exception?.description || 'Runtime exception')
      if (message.method === 'Runtime.consoleAPICalled' && message.params.type === 'error') clientErrors.push(message.params.args?.map(a => a.value || a.description || '').join(' ') || 'console.error')
      if (!message.id || !pending.has(message.id)) return
      const { resolve, reject } = pending.get(message.id)
      pending.delete(message.id)
      message.error ? reject(new Error(JSON.stringify(message.error))) : resolve(message.result)
    }
    await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject })
    const send = (method, params = {}) => new Promise((resolve, reject) => {
      const message = { id: ++id, method, params }
      pending.set(message.id, { resolve, reject })
      ws.send(JSON.stringify(message))
    })

    await send('Runtime.enable')
    await send('Page.enable')
    await send('Network.enable')
    await send('Network.setCookie', {
      name: 'proxima_session',
      value: token,
      url: BASE,
      httpOnly: true,
      sameSite: 'Lax',
    })
    if (mobile) {
      await send('Emulation.setDeviceMetricsOverride', {
        width,
        height,
        deviceScaleFactor: 2,
        mobile: true,
      })
    }
    await send('Page.navigate', { url: BASE })
    await sleep(2500)
    if (!mobile) {
      await workflowIntakeBrowserRegression(send, workflowFixture)
      await send('Page.navigate', { url: BASE })
      await sleep(2500)
    }
    const result = await send('Runtime.evaluate', {
      awaitPromise: true,
      returnByValue: true,
      expression: `(${async function (mobile) {
        const wait = ms => new Promise(resolve => setTimeout(resolve, ms))
        const body = () => document.body.innerText || ''
        const disabledLabels = new Set(['Design', 'Design Studio'])
        const visibleDisabledNav = [...document.querySelectorAll('.sidebar button, .sidebar a')]
          .map(node => (node.textContent || '').trim())
          .filter(label => disabledLabels.has(label))
        if (visibleDisabledNav.length) throw new Error(`disabled navigation visible: ${visibleDisabledNav.join(', ')}`)
        async function openMobileMenu() {
          if (!mobile || document.querySelector('.sidebar.is-open')) return
          const menu = document.querySelector('[aria-label="Menu"]')
          if (!menu) throw new Error('missing mobile menu button')
          menu.click()
          for (let i = 0; i < 20; i += 1) {
            await wait(100)
            if (document.querySelector('.sidebar.is-open')) return
          }
          throw new Error('mobile menu did not open')
        }
        async function clickLabel(label, expect) {
          await openMobileMenu()
          let el = null
          for (let i = 0; i < 40; i += 1) {
            const scope = mobile ? document.querySelector('.sidebar.is-open') || document : document
            el = [...scope.querySelectorAll('button, [role="button"], a')].find(node => (node.textContent || '').trim().includes(label))
            if (el) break
            await wait(150)
          }
          if (!el) throw new Error(`missing nav ${label}\n${body().slice(0, 500)}`)
          el.click()
          for (let i = 0; i < 40; i += 1) {
            await wait(150)
            if (body().includes(expect)) return `${label}:ok`
          }
          throw new Error(`${label} did not show ${expect}\\n${body().slice(0, 500)}`)
        }
        async function clickDesktopSettings() {
          if (mobile) return null
          const account = document.querySelector('[aria-label="Account actions"]')
          if (!account) throw new Error(`missing account menu\\n${body().slice(0, 500)}`)
          account.click()
          let settings = null
          for (let i = 0; i < 20; i += 1) {
            await wait(100)
            settings = [...document.querySelectorAll('.user-menu button, button')].find(node => (node.textContent || '').trim().includes('Settings'))
            if (settings) break
          }
          if (!settings) throw new Error(`missing settings menu item\\n${body().slice(0, 500)}`)
          settings.click()
          for (let i = 0; i < 40; i += 1) {
            await wait(150)
            const heading = document.querySelector('.settings-content-head h2')
            if ((heading?.textContent || '').trim() !== 'Account') continue
            async function clickSettingsSection(label, expect) {
              const section = [...document.querySelectorAll('.settings-menu-item')]
                .find(node => (node.textContent || '').includes(label))
              if (!section) throw new Error('missing settings section ' + label)
              section.click()
              for (let j = 0; j < 40; j += 1) {
                await wait(150)
                if (body().includes(expect)) return
              }
              throw new Error(label + ' did not show ' + expect)
            }
            await clickSettingsSection('Agents', 'Agent goals')
            await clickSettingsSection('Diagnostics', 'Debug logs')
            return 'Settings:ok'
          }
          throw new Error(`Settings did not show\\n${body().slice(0, 500)}`)
        }
        async function checkDelegateShell() {
          const delegate = [...document.querySelectorAll('.shell-mode-switch button')]
            .find(node => (node.textContent || '').trim() === 'Delegate')
          // Master remains feature-gated, so the standard smoke fixture normally
          // has no Delegate control. Enabled installations get this browser-only
          // navigation regression without changing the fixture's authority.
          if (!delegate) return null
          delegate.click()
          for (let i = 0; i < 40; i += 1) {
            await wait(100)
            if (document.querySelector('[aria-label="Delegate navigation"]')) break
          }
          const nav = document.querySelector('[aria-label="Delegate navigation"]')
          if (!nav) throw new Error(`Delegate navigation did not open\\n${body().slice(0, 500)}`)
          const labels = [...nav.querySelectorAll('button')].map(node => (node.textContent || '').trim())
          if (labels.join('|') !== 'Master|Tasks|Archive') throw new Error(`unexpected Delegate navigation: ${labels.join('|')}`)
          if (document.querySelector('[aria-label^="Active project:"]')) throw new Error('Delegate exposed a project selector')
          if (document.querySelector('[aria-label="Toggle sidebar"]')) throw new Error('Delegate exposed a sidebar collapse control')
          if (document.querySelector('[aria-label="Resize sidebar"]')) throw new Error('Delegate exposed a sidebar resize control')
          if (new URL(location.href).searchParams.get('mode') !== 'delegate') throw new Error('Delegate mode was not URL durable')
          for (const label of ['Tasks', 'Archive', 'Master']) {
            if (mobile) await openMobileMenu()
            const scope = mobile ? document.querySelector('.sidebar.is-open') || document : nav
            const button = [...scope.querySelectorAll('button')].find(node => (node.textContent || '').trim() === label)
            if (!button) throw new Error(`missing Delegate ${label} destination`)
            button.click()
            for (let i = 0; i < 40; i += 1) {
              await wait(100)
              if (button.getAttribute('aria-current') === 'page') break
            }
            if (new URL(location.href).searchParams.get('mode') !== 'delegate') throw new Error(`Delegate ${label} left its mode`)
          }
          return 'Delegate:ok'
        }
        const checks = [
          await clickLabel('Chat', 'Chat'),
          await clickLabel('Tasks', 'Tasks'),
          await clickLabel('Workflows', 'Workflows'),
          await clickLabel('Archive', 'Archive'),
        ]
        const settings = await clickDesktopSettings()
        if (settings) checks.push(settings)
        const delegate = await checkDelegateShell()
        if (delegate) checks.push(delegate)
        return JSON.stringify(checks)
      }})(${JSON.stringify(mobile)})`,
    })
    const rawChecks = result.result.value
    const checks = typeof rawChecks === 'string' ? JSON.parse(rawChecks) : rawChecks
    const expectedChecks = mobile ? 4 : 5
    if (!Array.isArray(checks) || checks.length < expectedChecks || checks.length > expectedChecks + 1 || checks.some(check => typeof check !== 'string' || !check.endsWith(':ok'))) {
      throw new Error(`unexpected browser check result: ${JSON.stringify({ checks, result })}`)
    }
    if (clientErrors.length) throw new Error(`browser client errors:\n${clientErrors.join('\n')}`)
    console.log(`browser:${name}: lazy navigation ok ${JSON.stringify(checks)}`)
    ws.close()
  } catch (err) {
    const hint = stderr.split('\n').filter(Boolean).slice(-5).join('\n')
    throw new Error(`${err.message}${hint ? `\nChrome stderr:\n${hint}` : ''}`)
  } finally {
    await stopBrowser(chrome, userDataDir)
  }
}

async function browserSmoke(token, workflowFixture) {
  if (SKIP_BROWSER) {
    console.log('browser: skipped (PROXIMA_SMOKE_SKIP_BROWSER=1)')
    return
  }
  if (typeof WebSocket === 'undefined') throw new Error('browser smoke needs a Node runtime with global WebSocket')

  const configuredPort = process.env.PROXIMA_SMOKE_CDP_PORT ? Number(process.env.PROXIMA_SMOKE_CDP_PORT) : null
  const desktopPort = configuredPort || await freePort()
  const mobilePort = configuredPort ? configuredPort + 1 : await freePort()
  await browserNavigationSmoke({ name: 'desktop', width: 1280, height: 900, port: desktopPort, mobile: false, token, workflowFixture })
  await browserNavigationSmoke({ name: 'mobile', width: 390, height: 844, port: mobilePort, mobile: true, token })
}

async function main() {
  console.log(`smoke: ${BASE}`)
  const token = await apiSmoke()
  const workflowFixture = SKIP_BROWSER ? null : await createWorkflowIntakeFixture(token)
  try {
    await browserSmoke(token, workflowFixture)
  } finally {
    await deleteWorkflowIntakeFixture(token, workflowFixture)
  }
  console.log('smoke: ok')
}

main().catch(err => {
  console.error(`smoke: failed\n${err.stack || err.message}`)
  process.exitCode = 1
})
