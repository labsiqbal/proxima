[Unit]
Description=Proxima self-hosted workspace
After=network.target proxima-preview-output.socket
Requires=proxima-preview-output.socket

[Service]
Type=simple
User=proxima
Group=proxima
EnvironmentFile=/etc/proxima/proxima.env
Environment=PROXIMA_OUTPUT_BROKER_SOCKET=/run/proxima-preview-output.sock
Environment=PROXIMA_OUTPUT_BROKER_PROTOCOL=proxima-preview-supervisor-v2:production
Environment=PROXIMA_PREVIEW_PROFILE=production
Environment=PROXIMA_PREVIEW_SCOPE_STATE_ROOT=/var/lib/proxima/preview-supervisors
WorkingDirectory=/opt/proxima
ExecStart=/opt/proxima/scripts/proxima serve
Restart=on-failure
RestartSec=3
KillMode=process
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
